+    pub(super) fn on_agent_reasoning_started(&mut self) {
+        if self.unified_exec_wait_streak.is_some() {
+            // Unified exec waiting should take precedence over reasoning-derived status headers.
+            self.request_redraw();
+            return;
+        }
+
+        self.set_reasoning_status_header_fallback();
+        self.request_redraw();
+    }
+
+    fn set_reasoning_status_header_fallback(&mut self) {
+        self.status_state.terminal_title_status_kind = TerminalTitleStatusKind::Thinking;
+        if self.bottom_pane.is_task_running() {
+            self.bottom_pane.ensure_status_indicator();
+        }
+        if self.status_state.current_status.header == "Working" {
+            self.set_status_header(String::from("Thinking"));
+        }
+    }
