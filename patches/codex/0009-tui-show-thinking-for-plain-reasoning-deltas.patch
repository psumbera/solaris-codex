+#[tokio::test]
+async fn reasoning_delta_without_bold_header_sets_thinking_status() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+
+    handle_turn_started(&mut chat, "turn-1");
+    assert_eq!(chat.status_state.current_status.header, "Working");
+
+    handle_agent_reasoning_delta(&mut chat, "I will inspect the request first.");
+    assert_eq!(chat.status_state.current_status.header, "Thinking");
+}
+
+#[tokio::test]
+async fn reasoning_item_start_without_summary_delta_sets_thinking_status() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+
+    handle_turn_started(&mut chat, "turn-1");
+    assert_eq!(chat.status_state.current_status.header, "Working");
+
+    handle_agent_reasoning_started(&mut chat);
+    assert_eq!(chat.status_state.current_status.header, "Thinking");
+    assert_eq!(
+        chat.bottom_pane.status_widget().map(|status| status.header()),
+        Some("Thinking")
+    );
+}
