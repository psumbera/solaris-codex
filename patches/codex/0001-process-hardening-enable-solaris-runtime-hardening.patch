This patch is needed because upstream process hardening only enables the
BSD-style pre-main hardening path on the BSD targets, while the Solaris
wrapper needs the same RLIMIT_CORE and LD_* cleanup behavior.

What it does:
- adds Solaris to the BSD-style pre-main hardening cfg gates
- keeps the existing runtime hardening behavior unchanged on other targets

Why it is needed:
- without it, the Solaris Codex binary inherits unsafe LD_* linker environment
  variables and does not disable core dumps at startup

diff --git a/codex-rs/process-hardening/src/lib.rs b/codex-rs/process-hardening/src/lib.rs
index f500e15..ebd82f5 100644
--- a/codex-rs/process-hardening/src/lib.rs
+++ b/codex-rs/process-hardening/src/lib.rs
@@ -16,8 +16,8 @@ pub fn pre_main_hardening() {
     #[cfg(target_os = "macos")]
     pre_main_hardening_macos();
 
-    // On FreeBSD and OpenBSD, apply similar hardening to Linux/macOS:
-    #[cfg(any(target_os = "freebsd", target_os = "openbsd"))]
+    // On FreeBSD, OpenBSD, and Solaris, apply similar hardening to Linux/macOS:
+    #[cfg(any(target_os = "freebsd", target_os = "openbsd", target_os = "solaris"))]
     pre_main_hardening_bsd();
 
     #[cfg(windows)]
@@ -36,7 +36,8 @@ const PTRACE_DENY_ATTACH_FAILED_EXIT_CODE: i32 = 6;
     target_os = "macos",
     target_os = "freebsd",
     target_os = "netbsd",
-    target_os = "openbsd"
+    target_os = "openbsd",
+    target_os = "solaris"
 ))]
 const SET_RLIMIT_CORE_FAILED_EXIT_CODE: i32 = 7;
 
@@ -71,9 +72,9 @@ pub fn disable_process_dumping() -> std::io::Result<()> {
     }
 }
 
-#[cfg(any(target_os = "freebsd", target_os = "openbsd"))]
+#[cfg(any(target_os = "freebsd", target_os = "openbsd", target_os = "solaris"))]
 pub(crate) fn pre_main_hardening_bsd() {
-    // FreeBSD/OpenBSD: set RLIMIT_CORE to 0 and clear LD_* env vars
+    // FreeBSD/OpenBSD/Solaris: set RLIMIT_CORE to 0 and clear LD_* env vars
     set_core_file_size_limit_to_zero();
 
     remove_env_vars_with_prefix(b"LD_");
