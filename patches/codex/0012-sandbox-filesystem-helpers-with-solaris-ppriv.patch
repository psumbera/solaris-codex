+#[cfg(target_os = "solaris")]
+fn solaris_helper_file_system_policy(
+    original: &FileSystemSandboxPolicy,
+    request: &FsHelperRequest,
+    cwd: &std::path::Path,
+    _workspace_roots: &[AbsolutePathBuf],
+) -> Result<FileSystemSandboxPolicy, JSONRPCErrorError> {
+    if matches!(
+        request,
+        FsHelperRequest::LoadCapabilityDiscoveries { .. }
+            | FsHelperRequest::DiscoverCapabilityRoots(_)
+    ) {
+        return Ok(original.clone());
+    }
+
+    let mut entries = Vec::new();
+    let mut add_path =
+        |path: &PathUri, access: FileSystemAccessMode| -> Result<(), JSONRPCErrorError> {
+            let native_path = path.to_abs_path().map_err(|err| {
+                invalid_request(format!("filesystem helper path is not native: {err}"))
+            })?;
+            let protected_metadata = access == FileSystemAccessMode::Write
+                && native_path.as_path().components().any(|component| {
+                    matches!(
+                        component,
+                        std::path::Component::Normal(name)
+                            if is_protected_metadata_name(name)
+                    )
+                });
+            let allowed = !protected_metadata
+                && match access {
+                    FileSystemAccessMode::Deny => false,
+                    FileSystemAccessMode::Read => {
+                        original.can_read_local_path_with_cwd(native_path.as_path(), cwd)
+                    }
+                    FileSystemAccessMode::Write => {
+                        original.can_write_local_path_with_cwd(native_path.as_path(), cwd)
+                    }
+                };
+            if !allowed {
+                return Err(invalid_request(format!(
+                    "filesystem sandbox denied {access:?} access to {path}"
+                )));
+            }
+
+            entries.push(FileSystemSandboxEntry::new(native_path.into(), access));
+            Ok(())
+        };
+
+    match request {
+        FsHelperRequest::LoadCapabilityDiscoveries { .. }
+        | FsHelperRequest::DiscoverCapabilityRoots(_) => unreachable!(),
+        FsHelperRequest::Open(params) => {
+            add_path(&params.path, FileSystemAccessMode::Read)?;
+        }
+        FsHelperRequest::ReadFile(params) => {
+            add_path(&params.path, FileSystemAccessMode::Read)?;
+        }
+        FsHelperRequest::WriteFile(params) => {
+            add_path(&params.path, FileSystemAccessMode::Write)?;
+        }
+        FsHelperRequest::CreateDirectory(params) => {
+            add_path(&params.path, FileSystemAccessMode::Write)?;
+        }
+        FsHelperRequest::GetMetadata(params) => {
+            add_path(&params.path, FileSystemAccessMode::Read)?;
+        }
+        FsHelperRequest::Canonicalize(params) => {
+            add_path(&params.path, FileSystemAccessMode::Read)?;
+        }
+        FsHelperRequest::ReadDirectory(params) => {
+            add_path(&params.path, FileSystemAccessMode::Read)?;
+        }
+        FsHelperRequest::Walk(params) => {
+            add_path(&params.path, FileSystemAccessMode::Read)?;
+        }
+        FsHelperRequest::Remove(params) => {
+            add_path(&params.path, FileSystemAccessMode::Write)?;
+        }
+        FsHelperRequest::Copy(params) => {
+            add_path(&params.source_path, FileSystemAccessMode::Read)?;
+            add_path(&params.destination_path, FileSystemAccessMode::Write)?;
+        }
+    }
+
+    Ok(FileSystemSandboxPolicy::restricted(entries))
+}
