 fn danger_full_access_defaults_to_no_sandbox_without_network_requirements() {
diff --git a/codex-rs/sandboxing/src/solaris.rs b/codex-rs/sandboxing/src/solaris.rs
--- /dev/null
+++ b/codex-rs/sandboxing/src/solaris.rs
