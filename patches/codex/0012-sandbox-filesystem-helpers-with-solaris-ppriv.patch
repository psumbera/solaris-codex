+    use codex_protocol::permissions::NetworkSandboxPolicy;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn creates_read_write_and_network_restrictions() {
+        let cwd = Path::new("/workspace");
+        let permissions = PermissionProfile::from_runtime_permissions(
+            &FileSystemSandboxPolicy::restricted(vec![
+                FileSystemSandboxEntry::new(
+                    AbsolutePathBuf::from_absolute_path("/workspace/input")
+                        .expect("absolute input")
+                        .into(),
+                    FileSystemAccessMode::Read,
+                ),
+                FileSystemSandboxEntry::new(
+                    AbsolutePathBuf::from_absolute_path("/workspace/output")
+                        .expect("absolute output")
+                        .into(),
+                    FileSystemAccessMode::Write,
+                ),
+            ]),
+            NetworkSandboxPolicy::Restricted,
+        );
+
+        let args = create_solaris_privileges_command_args(
+            vec!["tool".to_string(), "argument".to_string()],
+            &permissions,
+            cwd,
+        )
+        .expect("Solaris sandbox arguments");
+
+        assert_eq!(
+            args,
+            vec![
+                "-r",
+                "{file_read}:/workspace/input",
+                "-r",
+                "{file_read}:/workspace/input/*",
+                "-r",
+                "{file_read}:/workspace/output",
+                "-r",
+                "{file_read}:/workspace/output/*",
+                "-r",
+                "{file_write}:/workspace/output",
+                "-r",
+                "{file_write}:/workspace/output/*",
+                "-s",
+                "I-net_access",
+                "-e",
+                "tool",
+                "argument",
+            ]
+        );
+    }
+}
