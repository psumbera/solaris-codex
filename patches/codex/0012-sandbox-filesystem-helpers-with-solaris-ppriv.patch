--- /dev/null
+++ b/codex-rs/sandboxing/src/solaris.rs
@@ -0,0 +1,176 @@
+use codex_protocol::models::PermissionProfile;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::collections::BTreeSet;
+use std::path::Path;
+
+pub(crate) const SOLARIS_PATH_TO_PPRIV_EXECUTABLE: &str = "/usr/bin/ppriv";
+
+const EMPTY_POLICY_OBJECT: &str = "/dev/null/codex-sandbox-no-access";
+const MINIMAL_READ_ROOTS: &[&str] = &[
+    "/dev",
+    "/etc",
+    "/lib",
+    "/platform",
+    "/proc",
+    "/system",
+    "/usr",
+];
+
+pub(super) struct Solaris;
+
+impl crate::manager::SandboxBackend for Solaris {
+    fn prepare(
+        &mut self,
+        exec: &mut crate::SandboxExecRequest,
+        _cwd: &AbsolutePathBuf,
+        policy_cwd: &AbsolutePathBuf,
+    ) -> Result<(), crate::SandboxTransformError> {
+        let args = create_solaris_privileges_command_args(
+            std::mem::take(&mut exec.command),
+            &exec.permission_profile,
+            policy_cwd.as_path(),
+        )
+        .map_err(crate::SandboxTransformError::SolarisSandboxPreparation)?;
+        exec.command = std::iter::once(SOLARIS_PATH_TO_PPRIV_EXECUTABLE.to_owned())
+            .chain(args)
+            .collect();
+        Ok(())
+    }
+}
+
+pub(crate) fn create_solaris_privileges_command_args(
+    command: Vec<String>,
+    permission_profile: &PermissionProfile,
+    cwd: &Path,
+) -> Result<Vec<String>, String> {
+    let (file_system_policy, network_policy) = permission_profile.to_runtime_permissions();
+    let mut args = Vec::new();
+
+    if !file_system_policy.has_full_disk_read_access() {
+        let mut readable_roots = file_system_policy
+            .get_readable_roots_with_cwd(cwd)
+            .into_iter()
+            .collect::<BTreeSet<_>>();
+        if file_system_policy.include_platform_defaults() {
+            readable_roots.extend(
+                MINIMAL_READ_ROOTS
+                    .iter()
+                    .filter_map(|path| AbsolutePathBuf::from_absolute_path(path).ok()),
+            );
+        }
+        append_path_rules(&mut args, "file_read", readable_roots)?;
+    }
+
+    if !file_system_policy.has_full_disk_write_access() {
+        let writable_roots = file_system_policy
+            .get_writable_roots_with_cwd(cwd)
+            .into_iter()
+            .map(|root| root.root)
+            .collect::<BTreeSet<_>>();
+        append_path_rules(&mut args, "file_write", writable_roots)?;
+    }
+
+    if !network_policy.is_enabled() {
+        args.extend(["-s".to_string(), "I-net_access".to_string()]);
+    }
+
+    args.push("-e".to_string());
+    args.extend(command);
+    Ok(args)
+}
+
+fn append_path_rules(
+    args: &mut Vec<String>,
+    privilege: &str,
+    roots: BTreeSet<AbsolutePathBuf>,
+) -> Result<(), String> {
+    if roots.is_empty() {
+        append_rule(args, privilege, EMPTY_POLICY_OBJECT);
+        return Ok(());
+    }
+
+    for root in roots {
+        let path = root
+            .as_path()
+            .to_str()
+            .ok_or_else(|| format!("Solaris sandbox path is not UTF-8: {root:?}"))?;
+        if path
+            .chars()
+            .any(|character| matches!(character, ',' | '*' | '\n' | '\r'))
+        {
+            return Err(format!(
+                "Solaris extended privilege policy cannot encode path `{path}`"
+            ));
+        }
+        append_rule(args, privilege, path);
+        let descendant_path = format!("{}/*", path.trim_end_matches('/'));
+        append_rule(args, privilege, &descendant_path);
+    }
+    Ok(())
+}
+
+fn append_rule(args: &mut Vec<String>, privilege: &str, path: &str) {
+    args.extend(["-r".to_string(), format!("{{{privilege}}}:{path}")]);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::permissions::FileSystemAccessMode;
+    use codex_protocol::permissions::FileSystemSandboxEntry;
+    use codex_protocol::permissions::FileSystemSandboxPolicy;
+    use codex_protocol::permissions::NetworkSandboxPolicy;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn creates_read_write_and_network_restrictions() {
+        let cwd = Path::new("/workspace");
+        let permissions = PermissionProfile::from_runtime_permissions(
+            &FileSystemSandboxPolicy::restricted(vec![
+                FileSystemSandboxEntry::new(
+                    AbsolutePathBuf::from_absolute_path("/workspace/input")
+                        .expect("absolute input")
+                        .into(),
+                    FileSystemAccessMode::Read,
+                ),
+                FileSystemSandboxEntry::new(
+                    AbsolutePathBuf::from_absolute_path("/workspace/output")
+                        .expect("absolute output")
+                        .into(),
+                    FileSystemAccessMode::Write,
+                ),
+            ]),
+            NetworkSandboxPolicy::Restricted,
+        );
+
+        let args = create_solaris_privileges_command_args(
+            vec!["tool".to_string(), "argument".to_string()],
+            &permissions,
+            cwd,
+        )
+        .expect("Solaris sandbox arguments");
+
+        assert_eq!(
+            args,
+            vec![
+                "-r",
+                "{file_read}:/workspace/input",
+                "-r",
+                "{file_read}:/workspace/input/*",
+                "-r",
+                "{file_read}:/workspace/output",
+                "-r",
+                "{file_read}:/workspace/output/*",
+                "-r",
+                "{file_write}:/workspace/output",
+                "-r",
+                "{file_write}:/workspace/output/*",
+                "-s",
+                "I-net_access",
+                "-e",
+                "tool",
+                "argument",
+            ]
+        );
+    }
+}
