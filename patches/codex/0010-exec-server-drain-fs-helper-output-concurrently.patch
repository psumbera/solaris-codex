+    #[cfg(unix)]
+    #[tokio::test]
+    async fn run_command_drains_large_helper_stdout_before_waiting() {
+        let large_data = "A".repeat(128 * 1024);
+        let response_json = serde_json::json!({
+            "status": "ok",
+            "payload": {
+                "operation": "fs/readFile",
+                "response": {
+                    "dataBase64": large_data,
+                },
+            },
+        })
+        .to_string();
+        let file_system_policy = FileSystemSandboxPolicy::unrestricted();
+        let network_policy = NetworkSandboxPolicy::Enabled;
+        let permission_profile =
+            PermissionProfile::from_runtime_permissions(&file_system_policy, network_policy);
+        let command = codex_sandboxing::SandboxExecRequest {
+            command: vec![
+                "/usr/bin/printf".to_string(),
+                "%s\n".to_string(),
+                response_json,
+            ],
+            cwd: AbsolutePathBuf::current_dir().expect("cwd"),
+            env: HashMap::new(),
+            network: None,
+            sandbox: codex_sandboxing::SandboxType::None,
+            windows_sandbox_level: codex_protocol::config_types::WindowsSandboxLevel::Disabled,
+            windows_sandbox_private_desktop: false,
+            permission_profile,
+            file_system_sandbox_policy: file_system_policy,
+            network_sandbox_policy: network_policy,
+            arg0: None,
+        };
+
+        let payload = tokio::time::timeout(
+            std::time::Duration::from_secs(10),
+            super::run_command(command, Vec::new()),
+        )
+        .await
+        .expect("run_command should not hang")
+        .expect("helper command should succeed");
+
+        match payload {
+            crate::fs_helper::FsHelperPayload::ReadFile(response) => {
+                assert_eq!(response.data_base64.len(), 128 * 1024);
+            }
+            other => panic!("unexpected payload: {other:?}"),
+        }
+    }
