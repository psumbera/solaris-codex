+#[test]
+fn model_visible_web_run_history_preserves_saved_and_unrelated_schemas() {
+    let run = serde_json::json!({
+        "type": "function", "name": "run",
+        "parameters": {"type": "object", "properties": {
+            "search_query": {"type": "array"},
+            "open": {"type": "array"},
+            "literature_search_query": {"type": "array"}
+        }}
+    });
+    let mut other = run.clone();
+    other["name"] = serde_json::json!("other");
+    let saved = vec![ResponseItem::AdditionalTools {
+        id: None,
+        role: "developer".to_string(),
+        tools: vec![
+            serde_json::json!({"type": "namespace", "name": "web", "tools": [run, other]}),
+            serde_json::json!({"type": "namespace", "name": "papers", "tools": [run]}),
+            serde_json::json!({"type": "custom", "name": "exec",
+                "description": "Nested tools support literature_search_query"}),
+        ]
+        .into(),
+    }];
+    let original = serde_json::to_value(&saved).unwrap();
+    let mut request = saved.clone();
+    super::normalize_model_visible_web_run_history(&mut request);
+    let mut expected = original.clone();
+    expected[0]["tools"][0]["tools"][0]["parameters"]["properties"]
+        .as_object_mut()
+        .unwrap()
+        .remove("literature_search_query");
+    assert_eq!(serde_json::to_value(&request).unwrap(), expected);
+    assert_eq!(serde_json::to_value(saved).unwrap(), original);
+
+    // Already-compatible history should neither change nor clone the catalog.
+    let compatible = request.clone();
+    super::normalize_model_visible_web_run_history(&mut request);
+    let ResponseItem::AdditionalTools { tools: before, .. } = &compatible[0] else {
+        panic!("expected additional_tools");
+    };
+    let ResponseItem::AdditionalTools { tools: after, .. } = &request[0] else {
+        panic!("expected additional_tools");
+    };
+    assert!(Arc::ptr_eq(before, after));
+}
