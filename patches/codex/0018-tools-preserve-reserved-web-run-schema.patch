+fn model_visible_web_run_spec(mut spec: ToolSpec) -> ToolSpec {
+    // The reserved model-visible web.run schema does not accept the experimental
+    // literature field, even when model metadata advertises it. Only adapt the
+    // request copy: the registered executor and nested Code Mode schema retain
+    // the capability. Keep ordinary search, open, and other commands unchanged.
+    if let ToolSpec::Namespace(namespace) = &mut spec
+        && namespace.name == "web"
+    {
+        for tool in &mut namespace.tools {
+            if let ResponsesApiNamespaceTool::Function(tool) = tool
+                && tool.name == "run"
+                && let Some(properties) = &mut tool.parameters.properties
+            {
+                properties.remove("literature_search_query");
+            }
+        }
+    }
+    spec
+}
