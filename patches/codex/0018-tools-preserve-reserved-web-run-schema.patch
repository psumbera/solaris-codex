+#[test]
+fn model_visible_web_run_preserves_reserved_schema_and_nested_capability() {
+    for supports_literature in [false, true] {
+        for (namespace, name) in [("web", "run"), ("papers", "run"), ("web", "other")] {
+            let mut properties = BTreeMap::from([
+                (
+                    "search_query".to_string(),
+                    codex_tools::JsonSchema::string(None),
+                ),
+                ("open".to_string(), codex_tools::JsonSchema::string(None)),
+            ]);
+            if supports_literature {
+                properties.insert(
+                    "literature_search_query".to_string(),
+                    codex_tools::JsonSchema::string(None),
+                );
+            }
+            let original = ToolSpec::Namespace(codex_tools::ResponsesApiNamespace {
+                name: namespace.to_string(),
+                description: "Search tools".to_string(),
+                tools: vec![ResponsesApiNamespaceTool::Function(ResponsesApiTool {
+                    name: name.to_string(),
+                    description: "Search".to_string(),
+                    strict: false,
+                    defer_loading: None,
+                    parameters: codex_tools::JsonSchema::object(properties, None, None),
+                    output_schema: None,
+                })],
+            });
+            let visible = super::model_visible_web_run_spec(original.clone());
+            let mut expected = serde_json::to_value(&original).unwrap();
+            if namespace == "web" && name == "run" {
+                expected["tools"][0]["parameters"]["properties"]
+                    .as_object_mut()
+                    .unwrap()
+                    .remove("literature_search_query");
+            }
+            assert_eq!(serde_json::to_value(&visible).unwrap(), expected);
+            for tools in [
+                codex_tools::create_tools_json_for_responses_api(&[visible.clone()]).unwrap(),
+                codex_tools::create_tools_json_for_responses_lite(&[visible.clone()]).unwrap(),
+                serde_json::from_str::<Vec<serde_json::Value>>(
+                    codex_tools::create_tools_raw_json_for_responses_api(&[visible])
+                        .unwrap()
+                        .get(),
+                )
+                .unwrap(),
+            ] {
+                assert_eq!(tools, vec![expected.clone()]);
+            }
+            assert_eq!(
+                serde_json::to_value(original).unwrap()["tools"][0]["parameters"]["properties"]
+                    .get("literature_search_query")
+                    .is_some(),
+                supports_literature,
+                "the executor/Code Mode schema must retain its capability",
+            );
+        }
+    }
+}
