+        normalize_model_visible_web_run_history(&mut input);
         if !self.reasoning_effort_override_enabled(model_info) {
             // Unsupported models and disabled overrides must also accept saved history.
             // Filter only the request copy; persisted history remains unchanged.
@@ -3667,6 +3668,44 @@
     }
 }
 
+fn normalize_model_visible_web_run_history(input: &mut [ResponseItem]) {
+    // Failed or older turns may have persisted the rejected declaration.
+    // Adapt the request copy, never the saved history or nested Code Mode tools.
+    let has_literature = |tool: &serde_json::Value| {
+        tool["type"] == "function"
+            && tool["name"] == "run"
+            && tool
+                .pointer("/parameters/properties/literature_search_query")
+                .is_some()
+    };
+    for item in input {
+        let ResponseItem::AdditionalTools { tools, .. } = item else {
+            continue;
+        };
+        for index in 0..tools.len() {
+            let namespace = &tools[index];
+            if namespace["type"] != "namespace"
+                || namespace["name"] != "web"
+                || !namespace["tools"]
+                    .as_array()
+                    .is_some_and(|tools| tools.iter().any(has_literature))
+            {
+                continue;
+            }
+            if let Some(children) = Arc::make_mut(tools)[index]["tools"].as_array_mut() {
+                for tool in children.iter_mut().filter(|tool| has_literature(tool)) {
+                    if let Some(properties) = tool
+                        .pointer_mut("/parameters/properties")
+                        .and_then(serde_json::Value::as_object_mut)
+                    {
+                        properties.remove("literature_search_query");
+                    }
+                }
+            }
+        }
+    }
+}
