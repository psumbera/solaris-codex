This patch is needed because Codex TUI clipboard support assumes native
clipboard backends that are not maintained or reliable on Solaris.

What it does:
- disables native arboard-backed clipboard dependencies on Solaris
- returns a clear unsupported error for image paste on Solaris
- keeps SSH and OSC 52 text copy available for remote terminal use

Why it is needed:
- without it, the TUI either pulls in unsupported clipboard code paths or fails
  at runtime when clipboard actions are attempted on Solaris

diff --git a/codex-rs/tui/Cargo.toml b/codex-rs/tui/Cargo.toml
index 300449a..a73a5c1 100644
--- a/codex-rs/tui/Cargo.toml
+++ b/codex-rs/tui/Cargo.toml
@@ -134,9 +134,9 @@ windows-sys = { version = "0.52", features = [
 ] }
 winsplit = "0.1"
 
-# Clipboard support via `arboard` is not available on Android/Termux.
-# Only include it for non-Android targets so the crate builds on Android.
-[target.'cfg(not(target_os = "android"))'.dependencies]
+# Clipboard support via `arboard` is not available on Android/Termux or Solaris.
+# Only include it for targets where the native clipboard backend is supported.
+[target.'cfg(not(any(target_os = "android", target_os = "solaris")))'.dependencies]
 arboard = { workspace = true }
 
 
diff --git a/codex-rs/tui/src/clipboard_copy.rs b/codex-rs/tui/src/clipboard_copy.rs
index 038dc0b..dc4e8bf 100644
--- a/codex-rs/tui/src/clipboard_copy.rs
+++ b/codex-rs/tui/src/clipboard_copy.rs
@@ -146,7 +146,7 @@ fn is_wsl_session() -> bool {
 /// triggers `os_log` / `NSLog` output on stderr. Because the TUI owns the
 /// terminal, that stray output corrupts the display. We temporarily redirect
 /// fd 2 to `/dev/null` around the call to keep the screen clean.
-#[cfg(all(not(target_os = "android"), not(target_os = "linux")))]
+#[cfg(all(not(target_os = "android"), not(target_os = "linux"), not(target_os = "solaris")))]
 fn arboard_copy(text: &str) -> Result<Option<ClipboardLease>, String> {
     #[cfg(target_os = "macos")]
     let _stderr_lock = STDERR_SUPPRESSION_MUTEX
@@ -183,6 +183,11 @@ fn arboard_copy(_text: &str) -> Result<Option<ClipboardLease>, String> {
     Err("native clipboard unavailable on Android".to_string())
 }
 
+#[cfg(target_os = "solaris")]
+fn arboard_copy(_text: &str) -> Result<Option<ClipboardLease>, String> {
+    Err("native clipboard unavailable on Solaris".to_string())
+}
