This patch is needed because Codex TUI clipboard support assumes native
clipboard backends that are not maintained or reliable on Solaris.

What it does:
- disables native arboard-backed clipboard dependencies on Solaris
- returns clear unsupported errors for image and text paste on Solaris
- keeps SSH and OSC 52 text copy available for remote terminal use

Why it is needed:
- without it, the TUI either pulls in unsupported clipboard code paths or fails
  at runtime when clipboard actions are attempted on Solaris

diff --git a/codex-rs/tui/Cargo.toml b/codex-rs/tui/Cargo.toml
index 6c0b83a..c231dee 100644
--- a/codex-rs/tui/Cargo.toml
+++ b/codex-rs/tui/Cargo.toml
@@ -140,9 +140,9 @@ windows-sys = { version = "0.52", features = [
 ] }
 winsplit = "0.1"
 
-# Clipboard support via `arboard` is not available on Android/Termux.
-# Only include it for non-Android targets so the crate builds on Android.
-[target.'cfg(not(target_os = "android"))'.dependencies]
+# Clipboard support via `arboard` is not available on Android/Termux or Solaris.
+# Only include it for targets where the native clipboard backend is supported.
+[target.'cfg(not(any(target_os = "android", target_os = "solaris")))'.dependencies]
 arboard = { workspace = true }
 
 
