This patch is needed because Codex app-server daemon lifecycle locks use
flock(2), but Rust libc does not expose that interface on Solaris.

What it does:
- keeps the existing flock-based lock path on other Unix targets
- uses nonblocking fcntl(F_SETLK) write locks for Solaris daemon lock files
- compile-gates an unreachable flock branch after Solaris selects the shared
  installer directory-lock fallback
- preserves the same busy-vs-error behavior for pid and operation locks

Why it is needed:
- without it, codex-app-server-daemon fails to build on Solaris because
  libc::flock, LOCK_EX, and LOCK_NB are unavailable

diff --git a/codex-rs/app-server-daemon/src/install_lock.rs b/codex-rs/app-server-daemon/src/install_lock.rs
--- a/codex-rs/app-server-daemon/src/install_lock.rs
+++ b/codex-rs/app-server-daemon/src/install_lock.rs
@@ -109,7 +109,10 @@ pub(crate) async fn acquire_install_lock(root: &Path) -> Result<InstallLock> {
                 let result = if use_lockf {
                     unsafe { libc::lockf(file.as_raw_fd(), libc::F_TLOCK, 0) }
                 } else {
+                    #[cfg(not(target_os = "solaris"))]
                     unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) }
+                    #[cfg(target_os = "solaris")]
+                    unreachable!("Solaris installer locking uses the directory fallback")
                 };
                 if result != 0 {
                     return Err(std::io::Error::last_os_error());

diff --git a/codex-rs/app-server-daemon/src/backend/pid.rs b/codex-rs/app-server-daemon/src/backend/pid.rs
index b525e61..68c85dc 100644
--- a/codex-rs/app-server-daemon/src/backend/pid.rs
+++ b/codex-rs/app-server-daemon/src/backend/pid.rs
@@ -572,7 +572,7 @@ enum EmptyPidReservation {
     Record(PidRecord),
 }
 
-#[cfg(unix)]
+#[cfg(all(unix, not(target_os = "solaris")))]
 fn try_lock_file(file: &fs::File) -> Result<bool> {
     use std::os::fd::AsRawFd;
 
@@ -588,6 +588,35 @@ fn try_lock_file(file: &fs::File) -> Result<bool> {
     Err(err).context("failed to lock pid reservation")
 }
 
+#[cfg(target_os = "solaris")]
+fn try_lock_file(file: &fs::File) -> Result<bool> {
+    use std::os::fd::AsRawFd;
+
+    try_lock_fd(file.as_raw_fd()).context("failed to lock pid reservation")
+}
+
+#[cfg(target_os = "solaris")]
+fn try_lock_fd(fd: i32) -> std::io::Result<bool> {
+    let mut lock: libc::flock = unsafe { std::mem::zeroed() };
+    lock.l_type = libc::F_WRLCK as libc::c_short;
+    lock.l_whence = libc::SEEK_SET as libc::c_short;
+    lock.l_start = 0;
+    lock.l_len = 0;
+
+    let result = unsafe { libc::fcntl(fd, libc::F_SETLK, &lock) };
+    if result == 0 {
+        return Ok(true);
+    }
+
+    let err = std::io::Error::last_os_error();
+    match err.raw_os_error() {
+        Some(code) if code == libc::EAGAIN || code == libc::EACCES || code == libc::EINTR => {
+            Ok(false)
+        }
+        _ => Err(err),
+    }
+}
+
 #[cfg(not(any(unix, windows)))]
 fn try_lock_file(_file: &fs::File) -> Result<bool> {
     bail!("pid-managed app-server startup is unsupported on this platform")
