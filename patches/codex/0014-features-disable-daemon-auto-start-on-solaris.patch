From: Solaris Codex maintainers
Subject: [PATCH] Keep Solaris TUI startup in embedded mode by default

The Solaris package installs the Codex executables directly rather than the
complete standalone package tree. Automatic daemon bootstrap requires that
tree and otherwise exits before the TUI starts because codex-package.json is
not available.

Disable daemon auto-start by default on Solaris so an ordinary `codex` launch
continues to use its embedded app server. Users can still explicitly enable
the feature when running a complete package.

diff --git a/codex-rs/features/src/lib.rs b/codex-rs/features/src/lib.rs
--- a/codex-rs/features/src/lib.rs
+++ b/codex-rs/features/src/lib.rs
@@ -1099,7 +1099,7 @@
         id: Feature::DaemonAutoStart,
         key: "daemon_auto_start",
         stage: Stage::Stable,
-        default_enabled: true,
+        default_enabled: !cfg!(target_os = "solaris"),
     },
     FeatureSpec {
         id: Feature::TuiMultiBackend,
diff --git a/codex-rs/features/src/tests.rs b/codex-rs/features/src/tests.rs
--- a/codex-rs/features/src/tests.rs
+++ b/codex-rs/features/src/tests.rs
@@ -63,6 +63,12 @@
             );
         }
     }
+}
+
+#[cfg(target_os = "solaris")]
+#[test]
+fn daemon_auto_start_is_disabled_by_default_on_solaris() {
+    assert!(!Features::with_defaults().enabled(Feature::DaemonAutoStart));
 }
 
 #[test]
