+    #[tokio::test]
+    async fn converts_wal_snapshot_without_mapping_nfs_shm() -> anyhow::Result<()> {
+        let test_dir = tempfile::Builder::new()
+            .prefix("codex-sqlite-conversion-test-")
+            .tempdir_in("/tmp")?;
+        let source_path = test_dir.path().join("source.sqlite");
+        let fixture_path = test_dir.path().join("fixture.sqlite");
+
+        let mut source = SqliteConnectOptions::new()
+            .filename(&source_path)
+            .create_if_missing(true)
+            .journal_mode(SqliteJournalMode::Wal)
+            .connect()
+            .await?;
+        sqlx::query("PRAGMA wal_autocheckpoint=0")
+            .execute(&mut source)
+            .await?;
+        sqlx::query("CREATE TABLE test_data (value INTEGER NOT NULL)")
+            .execute(&mut source)
+            .await?;
+        sqlx::query("INSERT INTO test_data (value) VALUES (42)")
+            .execute(&mut source)
+            .await?;
+
+        let source_wal = sqlite_sidecar_path(&source_path, "-wal");
+        assert!(std::fs::metadata(&source_wal)?.len() > 0);
+        std::fs::copy(&source_path, &fixture_path)?;
+        std::fs::copy(
+            &source_wal,
+            sqlite_sidecar_path(&fixture_path, "-wal"),
+        )?;
+        source.close().await?;
+
+        assert!(sqlite_path_uses_wal(&fixture_path)?);
+        prepare_solaris_sqlite_for_rollback_journal(&fixture_path).await?;
+        assert!(!sqlite_path_uses_wal(&fixture_path)?);
+        assert!(!sqlite_sidecar_path(&fixture_path, "-wal").exists());
+        assert!(!sqlite_sidecar_path(&fixture_path, "-shm").exists());
+
+        let mut converted = SqliteConnectOptions::new()
+            .filename(&fixture_path)
+            .connect()
+            .await?;
+        let journal_mode: String = sqlx::query_scalar("PRAGMA journal_mode")
+            .fetch_one(&mut converted)
+            .await?;
+        let value: i64 = sqlx::query_scalar("SELECT value FROM test_data")
+            .fetch_one(&mut converted)
+            .await?;
+        converted.close().await?;
+
+        assert_eq!(journal_mode, "delete");
+        assert_eq!(value, 42);
