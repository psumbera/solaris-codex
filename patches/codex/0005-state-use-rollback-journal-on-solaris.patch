+fn sqlite_journal_mode(path: &Path) -> Result<SqliteJournalMode, Error> {
+    #[cfg(target_os = "solaris")]
+    if solaris_path_is_nfs(path)? {
+        return Ok(SqliteJournalMode::Delete);
+    }
+
+    #[cfg(not(target_os = "solaris"))]
+    let _ = path;
+    Ok(SqliteJournalMode::Wal)
+}
+
+#[cfg(target_os = "solaris")]
+fn solaris_path_is_nfs(path: &Path) -> Result<bool, Error> {
+    let filesystem_path = path.parent().unwrap_or(path);
+    let filesystem_path = CString::new(filesystem_path.as_os_str().as_bytes()).map_err(|_| {
+        Error::Io(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "SQLite path contains NUL",
+        ))
+    })?;
+    let mut stats = MaybeUninit::<libc::statvfs>::uninit();
+    if unsafe { libc::statvfs(filesystem_path.as_ptr(), stats.as_mut_ptr()) } != 0 {
+        return Err(Error::Io(std::io::Error::last_os_error()));
+    }
+    let stats = unsafe { stats.assume_init() };
+    let end = stats
+        .f_basetype
+        .iter()
+        .position(|&byte| byte == 0)
+        .unwrap_or(stats.f_basetype.len());
+    Ok(stats.f_basetype[..end]
+        .iter()
+        .map(|&byte| byte as u8)
+        .eq(b"nfs".iter().copied()))
+}
+
+#[cfg(target_os = "solaris")]
+fn cleanup_solaris_wal_sidecars(path: &Path) {
+    // WAL mode relies on mmap'ing the -shm sidecar, which is unreliable for
+    // Codex homes on Solaris NFS mounts. Older runs may have left an empty WAL
+    // plus stale SHM file before the Solaris rollback-journal switch.
+    let wal_path = sqlite_sidecar_path(path, "-wal");
+
+    let should_remove = match std::fs::metadata(&wal_path) {
+        Ok(metadata) => metadata.len() == 0,
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => true,
+        Err(err) => {
+            tracing::warn!(
+                "failed to inspect SQLite WAL sidecar {} before Solaris cleanup: {err}",
+                wal_path.display()
+            );
+            false
+        }
+    };
+
+    if !should_remove {
+        return;
+    }
+
+    remove_solaris_wal_sidecars(path);
+}
+
+#[cfg(target_os = "solaris")]
+fn remove_solaris_wal_sidecars(path: &Path) {
+    for sidecar in [
+        sqlite_sidecar_path(path, "-wal"),
+        sqlite_sidecar_path(path, "-shm"),
+    ] {
+        match std::fs::remove_file(&sidecar) {
+            Ok(()) => {}
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => {}
+            Err(err) => tracing::warn!(
+                "failed to remove stale SQLite sidecar {} before Solaris startup: {err}",
+                sidecar.display()
+            ),
+        }
+    }
+}
+
+#[cfg(target_os = "solaris")]
+fn sqlite_sidecar_path(path: &Path, suffix: &str) -> PathBuf {
+    let mut sidecar = OsString::from(path.as_os_str());
+    sidecar.push(suffix);
+    PathBuf::from(sidecar)
+}
+
+#[cfg(target_os = "solaris")]
+async fn prepare_solaris_sqlite_for_rollback_journal(path: &Path) -> Result<(), Error> {
+    match std::fs::metadata(path) {
+        Ok(_) => {}
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(err) => return Err(Error::Io(err)),
+    }
+
+    let parent = path.parent().ok_or_else(|| {
+        Error::Io(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "SQLite path has no parent directory",
+        ))
+    })?;
+    let lock_path = parent.join(".codex-sqlite-journal-migration.lock");
+    let lock_file = OpenOptions::new()
+        .create(true)
+        .read(true)
+        .write(true)
+        .mode(0o600)
+        .open(lock_path)
+        .map_err(Error::Io)?;
+    lock_solaris_file(&lock_file, true).map_err(Error::Io)?;
+
+    if !sqlite_path_uses_wal(path)? {
+        cleanup_solaris_wal_sidecars(path);
+        return Ok(());
+    }
+
+    let mut source_db = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(path)
+        .map_err(Error::Io)?;
+    lock_solaris_file(&source_db, false).map_err(|err| {
+        Error::Io(std::io::Error::new(
+            err.kind(),
+            format!(
+                "cannot convert WAL database {} while it is in use: {err}",
+                path.display()
+            ),
+        ))
+    })?;
+    if !sqlite_file_uses_wal(&mut source_db)? {
+        cleanup_solaris_wal_sidecars(path);
+        return Ok(());
+    }
+
+    let local_dir = tempfile::Builder::new()
+        .prefix("codex-sqlite-rollback-")
+        .tempdir_in("/tmp")
+        .map_err(Error::Io)?;
+    let filename = path.file_name().ok_or_else(|| {
+        Error::Io(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "SQLite path has no file name",
+        ))
+    })?;
+    let local_db_path = local_dir.path().join(filename);
+    if solaris_path_is_nfs(&local_db_path)? {
+        return Err(Error::Io(std::io::Error::other(
+            "cannot convert SQLite WAL database because /tmp is NFS-backed",
+        )));
+    }
+    let mut local_db = File::create(&local_db_path).map_err(Error::Io)?;
+    source_db.seek(SeekFrom::Start(0)).map_err(Error::Io)?;
+    std::io::copy(&mut source_db, &mut local_db).map_err(Error::Io)?;
+    local_db.sync_all().map_err(Error::Io)?;
+
+    let wal_path = sqlite_sidecar_path(path, "-wal");
+    match File::open(&wal_path) {
+        Ok(mut source_wal) => {
+            let local_wal_path = sqlite_sidecar_path(&local_db_path, "-wal");
+            let mut local_wal = File::create(local_wal_path).map_err(Error::Io)?;
+            std::io::copy(&mut source_wal, &mut local_wal).map_err(Error::Io)?;
+            local_wal.sync_all().map_err(Error::Io)?;
+        }
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => {}
+        Err(err) => return Err(Error::Io(err)),
+    }
+
+    let options = SqliteConnectOptions::new()
+        .filename(&local_db_path)
+        .create_if_missing(true)
+        .journal_mode(SqliteJournalMode::Delete)
+        .synchronous(SqliteSynchronous::Normal)
+        .busy_timeout(Duration::from_secs(5))
+        .log_statements(LevelFilter::Off);
+    let conn = options.connect().await?;
+    conn.close().await?;
+
+    if sqlite_path_uses_wal(&local_db_path)? {
+        return Err(Error::Io(std::io::Error::other(
+            "local SQLite WAL conversion did not select rollback journaling",
+        )));
+    }
+
+    let source_permissions = source_db.metadata().map_err(Error::Io)?.permissions();
+    let mut converted_db = File::open(&local_db_path).map_err(Error::Io)?;
+    let mut replacement = tempfile::Builder::new()
+        .prefix(".codex-sqlite-rollback-")
+        .tempfile_in(parent)
+        .map_err(Error::Io)?;
+    std::io::copy(&mut converted_db, replacement.as_file_mut()).map_err(Error::Io)?;
+    replacement
+        .as_file()
+        .set_permissions(source_permissions)
+        .map_err(Error::Io)?;
+    replacement.as_file().sync_all().map_err(Error::Io)?;
+    let replacement_file = replacement
+        .persist(path)
+        .map_err(|err| Error::Io(err.error))?;
+    replacement_file.sync_all().map_err(Error::Io)?;
+
+    remove_solaris_wal_sidecars(path);
+    Ok(())
+}
+
+#[cfg(target_os = "solaris")]
+fn sqlite_path_uses_wal(path: &Path) -> Result<bool, Error> {
+    let mut file = File::open(path).map_err(Error::Io)?;
+    sqlite_file_uses_wal(&mut file)
+}
+
+#[cfg(target_os = "solaris")]
+fn sqlite_file_uses_wal(file: &mut File) -> Result<bool, Error> {
+    const SQLITE_HEADER_LEN: usize = 20;
+    const SQLITE_MAGIC: &[u8; 16] = b"SQLite format 3\0";
+
+    let mut header = [0_u8; SQLITE_HEADER_LEN];
+    file.seek(SeekFrom::Start(0)).map_err(Error::Io)?;
+    match file.read_exact(&mut header) {
+        Ok(()) => {}
+        Err(err) if err.kind() == std::io::ErrorKind::UnexpectedEof => return Ok(false),
+        Err(err) => return Err(Error::Io(err)),
+    }
+    Ok(&header[..SQLITE_MAGIC.len()] == SQLITE_MAGIC
+        && (header[18] == 2 || header[19] == 2))
+}
+
+#[cfg(target_os = "solaris")]
+fn lock_solaris_file(file: &File, wait: bool) -> std::io::Result<()> {
+    let mut lock: libc::flock = unsafe { std::mem::zeroed() };
+    lock.l_type = libc::F_WRLCK as libc::c_short;
+    lock.l_whence = libc::SEEK_SET as libc::c_short;
+    lock.l_start = 0;
+    lock.l_len = 0;
+    let command = if wait { libc::F_SETLKW } else { libc::F_SETLK };
+
+    loop {
+        if unsafe { libc::fcntl(file.as_raw_fd(), command, &lock) } == 0 {
+            return Ok(());
+        }
+        let err = std::io::Error::last_os_error();
+        if err.raw_os_error() == Some(libc::EINTR) {
+            continue;
+        }
+        return Err(err);
+    }
+}
