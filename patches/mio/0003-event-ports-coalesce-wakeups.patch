+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn repeated_wakes_are_coalesced() {
+        let mut selector = Selector::new().unwrap();
+        let token = Token(42);
+        let mut events = Events::with_capacity(1);
+
+        for _ in 0..64 {
+            selector.wake(token).unwrap();
+        }
+        selector
+            .select(&mut events, Some(Duration::ZERO))
+            .unwrap();
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].portev_user as usize, usize::from(token));
+
+        selector
+            .select(&mut events, Some(Duration::ZERO))
+            .unwrap();
+        assert!(events.is_empty());
     }
 }
 
