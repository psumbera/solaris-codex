+fn associate(port: RawFd, fd: RawFd, interests: Interest, generation: usize) -> io::Result<()> {
+    syscall_result(unsafe {
+        port_associate(
+            port,
+            PORT_SOURCE_FD,
+            fd as libc::uintptr_t,
+            interests_to_port(interests),
+            generation as *mut libc::c_void,
+        )
+    })
+    .map(|_| ())
+}
