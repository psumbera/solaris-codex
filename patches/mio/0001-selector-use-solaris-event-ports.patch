+#[derive(Debug, Clone)]
+pub struct Event {
+    token: Token,
+    events: EventMask,
+}
+
+pub type Events = Vec<Event>;
+
+pub mod event {
+    use std::fmt;
+
+    use crate::sys::Event;
+    use crate::Token;
+
+    use super::{EventMask, POLLRDHUP};
+
+    pub fn token(event: &Event) -> Token {
+        event.token
+    }
+
+    pub fn is_readable(event: &Event) -> bool {
+        (event.events & libc::POLLIN as EventMask) != 0
+            || (event.events & libc::POLLPRI as EventMask) != 0
+    }
+
+    pub fn is_writable(event: &Event) -> bool {
+        (event.events & libc::POLLOUT as EventMask) != 0
+    }
+
+    pub fn is_error(event: &Event) -> bool {
+        (event.events & libc::POLLERR as EventMask) != 0
+    }
+
+    pub fn is_read_closed(event: &Event) -> bool {
+        (event.events & libc::POLLHUP as EventMask) != 0 || (event.events & POLLRDHUP) != 0
+    }
+
+    pub fn is_write_closed(event: &Event) -> bool {
+        (event.events & libc::POLLHUP as EventMask) != 0
+            || ((event.events & libc::POLLOUT as EventMask) != 0
+                && (event.events & libc::POLLERR as EventMask) != 0)
+            || event.events == libc::POLLERR as EventMask
+    }
+
+    pub fn is_priority(event: &Event) -> bool {
+        (event.events & libc::POLLPRI as EventMask) != 0
+    }
+
+    pub fn is_aio(_: &Event) -> bool {
+        false
+    }
+
+    pub fn is_lio(_: &Event) -> bool {
+        false
+    }
+
+    pub fn debug_details(f: &mut fmt::Formatter<'_>, event: &Event) -> fmt::Result {
+        #[allow(clippy::trivially_copy_pass_by_ref)]
+        fn check_events(got: &EventMask, want: &libc::c_short) -> bool {
+            (*got & EventMask::from(*want)) != 0
+        }
+        debug_detail!(
+            EventsDetails(EventMask),
+            check_events,
+            libc::POLLIN,
+            libc::POLLPRI,
+            libc::POLLOUT,
+            libc::POLLRDNORM,
+            libc::POLLRDBAND,
+            libc::POLLWRNORM,
+            libc::POLLWRBAND,
+            libc::POLLERR,
+            libc::POLLHUP,
+        );
+
+        f.debug_struct("port_event")
+            .field("token", &event.token)
+            .field("events", &EventsDetails(event.events))
+            .finish()
+    }
+}
