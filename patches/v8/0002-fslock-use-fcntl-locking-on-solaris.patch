+/// Tries to lock a file but returns as soon as possible if already locked.
+#[cfg(any(target_os = "solaris", target_os = "illumos"))]
+pub fn try_lock(fd: FileDesc) -> Result<bool, Error> {
+    let mut lock = libc::flock {
+        l_type: libc::F_WRLCK,
+        l_whence: libc::SEEK_SET as libc::c_short,
+        l_start: 0,
+        l_len: 0,
+        l_sysid: 0,
+        l_pid: 0,
+        l_pad: [0; 4],
+    };
+    let res = unsafe { libc::fcntl(fd, libc::F_SETLK, &mut lock) };
+    if res >= 0 {
+        Ok(true)
+    } else {
+        let err = errno();
+        if err == libc::EWOULDBLOCK || err == libc::EAGAIN || err == libc::EACCES || err == libc::EINTR {
+            Ok(false)
+        } else {
+            Err(Error::from_raw_os_error(err as i32))
+        }
+    }
+}
