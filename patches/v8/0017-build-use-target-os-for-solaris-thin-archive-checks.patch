This patch is needed because the earlier thin-archive workaround must key off
target_os rather than current_os when host and target compatibility branches are
mixed during the Solaris wrapper build.

What it does:
- switches the Solaris thin-archive guards from current_os to target_os

Why it is needed:
- without it, cross-checked GN conditions can still route Solaris targets into
  the wrong archive branch

--- a/v8-149.2.0/build/config/compiler/BUILD.gn
+++ b/v8-149.2.0/build/config/compiler/BUILD.gn
@@ -2608,7 +2608,7 @@
 # 2. Remove the thin_archive config, so that the .a file actually contains all
 #    .o files, instead of just references to .o files in the build directoy
 config("thin_archive") {
-  if ((is_apple && use_lld) || (is_linux && current_os != "solaris" && !is_clang) || current_os == "aix") {
+  if ((is_apple && use_lld) || (is_linux && target_os != "solaris" && !is_clang) || current_os == "aix") {
     # The macOS and iOS linker ld64.ldd doesn't support thin archive without
     # symbol table, gcc on linux also throws the error `archive has no index`.
     # AIX does support -s option, not -S option.
@@ -2616,7 +2616,7 @@
       "-T",
       "-s",
     ]
-  } else if ((is_posix && current_os != "solaris" && (!is_apple || use_lld)) || is_fuchsia) {
+  } else if ((is_posix && target_os != "solaris" && (!is_apple || use_lld)) || is_fuchsia) {
     # The macOS and iOS default linker ld64 does not support reading thin
     # archives.
     arflags = [
