This patch is needed because Solaris stack-segment discovery and archive tool
behavior differ from the Linux-oriented defaults in Chromium and V8.

What it does:
- includes thr_stksegment support for the Solaris V8 platform code
- disables thin-archive usage in the affected Solaris compiler config path

Why it is needed:
- without it, the Solaris build either uses the wrong stack helpers or hits
  archive handling that the Solaris toolchain does not support correctly

--- a/v8-150.4.0/build/config/compiler/BUILD.gn
+++ b/v8-150.4.0/build/config/compiler/BUILD.gn
@@ -2303,17 +2303,19 @@
 # 2. Remove the thin_archive config, so that the .a file actually contains all
 #    .o files, instead of just references to .o files in the build directoy
 config("thin_archive") {
-  if ((is_apple && use_lld) || (is_linux && !is_clang) || current_os == "aix" ||
-      current_os == "zos") {
+  if ((is_apple && use_lld) ||
+      (is_linux && target_os != "solaris" && !is_clang) ||
+      current_os == "aix" || current_os == "zos") {
     # The macOS and iOS linker ld64.ldd doesn't support thin archive without
     # symbol table, gcc on linux also throws the error `archive has no index`.
     # AIX does support -s option, not -S option.
     arflags = [
       "-T",
       "-s",
     ]
-  } else if ((is_posix && (!is_apple || (use_lld || use_mold))) || is_fuchsia) {
+  } else if ((is_posix && target_os != "solaris" &&
+              (!is_apple || (use_lld || use_mold))) || is_fuchsia) {
     # The macOS and iOS default linker ld64 does not support reading thin
     # archives.
     arflags = [
       "-T",
--- a/v8-150.4.0/v8/src/base/platform/platform-solaris.cc
+++ b/v8-150.4.0/v8/src/base/platform/platform-solaris.cc
@@ -18,6 +18,7 @@
 #include <sys/mman.h>  // mmap()
 #include <sys/regset.h>
 #include <sys/stack.h>  // for stack alignment
+#include <thread.h>  // thr_stksegment
 #include <sys/time.h>  // gettimeofday(), timeradd()
 #include <time.h>
 #include <ucontext.h>  // walkstack(), getcontext()
@@ -74,17 +75,9 @@
 // static
 Stack::StackSlot Stack::ObtainCurrentThreadStackStart() {
-  pthread_attr_t attr;
-  int error;
-  pthread_attr_init(&attr);
-  error = pthread_attr_get_np(pthread_self(), &attr);
+  stack_t stack;
+  int error = thr_stksegment(&stack);
   if (!error) {
-    void* base;
-    size_t size;
-    error = pthread_attr_getstack(&attr, &base, &size);
-    CHECK(!error);
-    pthread_attr_destroy(&attr);
-    return reinterpret_cast<uint8_t*>(base) + size;
+    return stack.ss_sp;
   }
-  pthread_attr_destroy(&attr);
   return nullptr;
 }
