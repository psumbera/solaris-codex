This patch is needed because Chromium build config gates several default
toolchain selections behind Linux-like conditions that the Solaris wrapper must
reuse during GN generation.

What it does:
- treats Solaris as Linux-like in the affected Chromium build config branches
- lets the wrapper reuse the Linux-oriented toolchain path selection where that
  compatibility assumption is intentional

Why it is needed:
- without it, GN refuses the expected toolchain path setup for the Solaris V8
  wrapper build

--- a/v8-150.4.0/build/config/BUILDCONFIG.gn
+++ b/v8-150.4.0/build/config/BUILDCONFIG.gn
@@ -243,7 +243,7 @@
   # Targeting android on Mac is best-effort and not guaranteed to work.
   assert(host_os == "linux", "Android builds are only supported on Linux.")
   _default_toolchain = "//build/toolchain/android:android_clang_$target_cpu"
-} else if (target_os == "chromeos" || target_os == "linux") {
+} else if (target_os == "chromeos" || target_os == "linux" || target_os == "solaris") {
   # See comments in build/toolchain/cros/BUILD.gn about board compiles.
   if (is_clang) {
     _default_toolchain = "//build/toolchain/linux:clang_$target_cpu"
@@ -315,7 +315,7 @@
 is_chromeos = current_os == "chromeos"
 is_fuchsia = current_os == "fuchsia"
 is_ios = current_os == "ios"
-is_linux = current_os == "linux"
+is_linux = current_os == "linux" || current_os == "solaris"
 is_mac = current_os == "mac"
 is_wasm = current_os == "emscripten"
 is_watchos = current_os == "watchos"
